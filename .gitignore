# Secrets and local tooling, never commit
tools/serviceAccountKey.json
serviceAccountKey.json
# Firebase Admin SDK keys + any service-account JSON (broad safety net)
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
.dev.vars
.env
node_modules/
tools/node_modules
# The worktree recipe and the pre-push hook both say `ln -s .../test/node_modules`; a symlink is a file,
# so `node_modules/` above never matched it and every worktree showed it as untracked.
test/node_modules
tools/package.json
tools/package-lock.json
*.log
.DS_Store

# local theme mocks (never deploy)
_mock-*.html

# Layer-1 source illustrations (large; composed outputs in app/journey-art/ are what ship)
art-src/

# Capacitor native wrapper — generated/built ON THE MAC and regenerable from capacitor.config.json
# (npm i @capacitor/* + npx cap add ios android). Kept OUT of git so the Cloudflare Worker, which
# serves the whole repo ([assets] directory="./"), never publishes or trips over them.
/ios/
/android/
/package.json
/package-lock.json
/cap-web/App/

# TestFlight export config + scratch (local only)
native-build/

# NEVER commit signing keys (the Worker serves the whole repo)
*.p8
credentials/

# Question-gap analysis embedding cache (tools/rag/question_gaps.js) — local, cheap to rebuild
tools/rag/.embedding-cache.json

# Local-only scratch (test downloads, samples). Never committed; .assetsignore keeps it off the site too.
_local/

# Local working folders, never committed (tools/deploy_exclusion_check.js walks for them at any depth):
# wrangler's cache and state (.wrangler/cache/cf.json holds this machine's location and network) and
# screenshot proof sets (proof/, admin screens with sample data). .assetsignore keeps them off the site too.
.wrangler/
proof/

# Chaos and fuzz output: open bugs, with repro steps. The repo is public, so these never leave this Mac.
chaos-failures/
reports-dryrun/
