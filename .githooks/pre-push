#!/bin/sh
# The last local question before a push. On this repo a merge to main IS a deploy, and main only takes
# merges through a PR whose CI is green (branch protection: required checks, strict, enforce_admins).
#
# WHY THIS FILE EXISTS HERE AND NOT IN .git/hooks. It used to live in .git/hooks, installed by
# tools/install_hooks.sh. Then core.hooksPath was pointed at .githooks so the pre-commit hook could
# be tracked and travel with a clone. Git then stops looking in .git/hooks ENTIRELY, so the pre-push
# hook was still sitting there, still executable, and had not run before a single push since.
#
#   git rev-parse --git-path hooks/pre-push     <- tells you the ONE path git will use
#
# tools/hooks_check.js asserts that path exists and is executable, so this cannot rot again.
#
# WHAT IT RUNS (28 Nov 2026, docs/TESTING.md). Git hands this hook one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# 1. A push to main is refused UP FRONT, before anything else runs. GitHub refuses it anyway (main needs
#    passing status checks), so it used to fail only after the full suite had run here for 104-140 min.
#    The way in is a PR: the daily train is `node tools/train.js --go`, which pushes train/<stamp> and
#    opens its PR.
# 2. One push at a time on this machine (the push lock, below).
# 3. tools/change_test_check.js reads the ranges: product code changed with no test or gate changed,
#    and no "Test-exempt: <reason>" trailer, stops the push.
# That is all. A branch push runs NO gates here: CI runs them on the PR (.github/workflows/gates.yml), and a
# red PR cannot merge. The 23-minute Chrome-free run this hook used to make was the very command CI's `gates`
# job runs again on the same tree minutes later.
# test/prepush-tier.test.js feeds this file real stdin in a throwaway repo and checks each of these.

ROOT=$(git rev-parse --show-toplevel)

# git's stdin can be read once; keep it.
RANGES=$(cat)

if printf '%s\n' "$RANGES" | awk '$3 == "refs/heads/main" { found = 1 } END { exit !found }'; then
  echo "✋ This push targets main. main requires passing status checks, so GitHub refuses a direct push:"
  echo "   open a PR instead. Push your branch (git push origin HEAD:<your-branch>) and run"
  echo "   gh pr create --base main. The daily train does both: node tools/train.js --go"
  exit 1
fi

# One push at a time on this machine. Two pushes ran their suites together on 27 Nov 2026: they clashed on
# ports and load, and a self-test failed that passes alone. A branch push runs no gates now, so what the lock
# holds is the hook's one remaining job, tools/change_test_check.js, which goes through with_push_lock: perl
# takes an exclusive flock on one file (waiting, and saying for whom, while another push holds it), writes
# "pid name branch" into it for the next waiter's message, and runs the check.
# A kernel flock and not a mkdir with a pid in it, because a flock has no stale state: the kernel lets it go
# when perl exits, however it exits, SIGKILL and reboot included. The first version was a mkdir lock and a
# skeptic broke it three ways (28 Nov): six waiters behind a dead holder all took it over and ran at once, a
# lock left with no name was waited on forever, and so was a lock path that could not be made.
# The lock fd is close-on-exec (perl's default above fd 2), so a process the check leaks cannot keep it.
# CUBBY_PUSH_LOCK moves it (tests point it at temp dirs, never the real one). A job that already holds this
# lock and pushes (e.g. a queued train run) exports CUBBY_PUSH_LOCK_HELD=<the lock>, and the push runs
# at once instead of waiting forever on its own parent; with_push_lock exports it for
# everything it runs. A push to main is refused above, before the lock, so it never waits behind a holder.
# test/push-lock.test.js stages a live holder, a SIGKILLed one, six pushes at once and an unmakeable path.
PUSH_LOCK=${CUBBY_PUSH_LOCK:-${XDG_CACHE_HOME:-$HOME/.cache}/cubby/push.flock}
if ! { mkdir -p "$(dirname "$PUSH_LOCK")" && : >> "$PUSH_LOCK"; } 2>/dev/null || ! command -v perl >/dev/null 2>&1; then
  echo "✋ the machine push lock $PUSH_LOCK cannot be made (or perl, which takes it, is missing)."
  echo "   Point CUBBY_PUSH_LOCK at a writable file, or push with --no-verify if you have decided that is acceptable."
  exit 1
fi
PUSH_OWNER="$$ $(basename "$ROOT") $(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
with_push_lock() {
  if [ "${CUBBY_PUSH_LOCK_HELD:-}" = "$PUSH_LOCK" ]; then "$@"; return; fi
  perl -MFcntl=:flock -e '
    $| = 1;
    my ($lock, $who) = (shift, shift);
    open(my $fh, ">>", $lock) or do { print "Push lock: cannot open $lock ($!).\n"; exit 1 };
    unless (flock($fh, LOCK_EX | LOCK_NB)) {
      my $h = ""; if (open(my $r, "<", $lock)) { $h = <$r> // ""; chomp $h; close $r }
      print "Waiting for another push on this machine to finish (holder: ", ($h eq "" ? "unknown" : $h), "; lock $lock).\n";
      flock($fh, LOCK_EX) or do { print "Push lock: cannot lock $lock ($!).\n"; exit 1 };
    }
    truncate($fh, 0); syswrite($fh, "$who\n");
    $ENV{CUBBY_PUSH_LOCK_HELD} = $lock;
    my $rc = system { $ARGV[0] } @ARGV;
    exit($rc == -1 ? 127 : ($rc & 127) ? 128 + ($rc & 127) : $rc >> 8);
  ' "$PUSH_LOCK" "$PUSH_OWNER" "$@"
}

if ! printf '%s\n' "$RANGES" | with_push_lock node "$ROOT/tools/change_test_check.js" --stdin; then
  echo ""
  echo "Push stopped: product code changed and no test did. Add the test that proves it, or put"
  echo "   Test-exempt: <why no test can see this>"
  echo "on one of the commits, or push with --no-verify if you have decided that is acceptable."
  exit 1
fi

echo "Branch push: no gates run here. CI runs them on the PR, and a red PR cannot merge."
exit 0
