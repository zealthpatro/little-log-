/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# ---------------------------------------------------------------------------
# Caching. Cloudflare's default for static assets is `max-age=0, must-revalidate`,
# so EVERY file costs a network round trip on every visit — measured at ~26 requests
# for a cold /app/ load. The rules below buy that back, but only for files whose
# bytes are pinned by their path. Anything a deploy can change under a stable name
# is deliberately left on the default.
#
# THE RULE IF YOU EDIT THIS FILE: never add a long max-age to a path whose contents
# can change without the name changing. A wrong header here is close to unfixable —
# browsers that already cached it will not ask again for the full duration, and there
# is no way to reach them.
# ---------------------------------------------------------------------------

# The service workers are how a new build reaches an installed app: they must never
# be held in the HTTP cache. /app/sw.js is the PWA's; /sw.js is the marketing site's.
# app/sw.js also re-fetches its precache list through the HTTP cache on every version
# bump, which is the reason /app/*.js below is NOT cached — a stale hit there would
# make a new service worker install the previous build's JavaScript.
/sw.js
  Cache-Control: no-cache
/app/sw.js
  Cache-Control: no-cache
/app/firebase-messaging-sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/app/manifest.webmanifest
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: no-cache
/robots.txt
  Cache-Control: no-cache

# Firebase SDK: the version lives in the path (/app/vendor/firebase/10.12.2/...), so a
# bump is a new URL and these bytes are immutable by construction. ~160KB, and the
# single biggest item on the app's cold critical path since we stopped using gstatic.
/app/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Font binaries. The name encodes family + weight + subset, so the bytes only change if
# the typeface itself does — at which point the file is regenerated under a new name.
# fonts.css is intentionally NOT covered: it is the one file here a redesign can rewrite.
/app/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# App icons and logos: fixed names, and a change is cosmetic rather than functional,
# so a month of staleness costs nothing worth the round trips it saves.
/icons/*
  Cache-Control: public, max-age=2592000

# Marketing CSS/JS. These DO change on deploy and there is no service worker on the
# marketing site to force an update, so they get a short window plus
# stale-while-revalidate: a repeat visit inside 10 minutes makes no request at all,
# and after that the browser paints from cache immediately while refreshing in the
# background. Worst case a returning visitor sees the previous build for one load.
/site.css
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/vax.css
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/rail.js
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/vax.js
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/install.js
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/news-widget.js
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
