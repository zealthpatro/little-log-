rules_version = '2';

// Little Log security rules.
// - Data lives under /households/{hid}; only that household's members can read/write it.
// - Outsiders (non-members, non-invitees) are fully blocked.
// - Owners can manage membership; caregivers can add entries and edit/delete their own.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's private pointer to their household.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Beta feedback: any signed-in user can submit; only the project owner reads it (console).
    match /feedback/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Pro waitlist: a user manages their own signup; only the project owner reads (console).
    match /waitlist/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Invites are keyed by the invitee's lowercased email.
    match /invites/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members[request.auth.uid] == 'owner';
      allow update: if request.auth != null && (
        request.auth.token.email.lower() == email
        || get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members[request.auth.uid] == 'owner'
      );
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members[request.auth.uid] == 'owner';
    }

    match /households/{hid} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      function isOwner() {
        return request.auth != null && resource.data.members[request.auth.uid] == 'owner';
      }
      function invitedHere() {
        return request.auth != null
          && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
          && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.householdId == hid;
      }
      // Pro entitlement is set ONLY by the billing Worker (Admin credentials bypass rules).
      // No client, owner included, may grant or change it.
      function proUnchanged() {
        return request.resource.data.get('pro', null) == resource.data.get('pro', null);
      }

      allow read:   if isMember() || invitedHere();
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.get('pro', null) == null;
      // Owner can change anything (except pro). A caregiver may edit shared data but NOT
      // membership/owner (no privilege escalation). An invitee may join (adds themselves).
      allow update: if proUnchanged() && (
           isOwner()
        || ( isMember()
             && request.resource.data.ownerId == resource.data.ownerId
             && request.resource.data.members == resource.data.members )
        || invitedHere() );
      allow delete: if request.auth != null && resource.data.members[request.auth.uid] == 'owner';

      // Members of THIS household (resolved fresh each check).
      function pm() { return get(/databases/$(database)/documents/households/$(hid)).data.members; }

      match /events/{eventId} {
        allow read, create: if request.auth != null && request.auth.uid in pm();
        // Owner can edit/remove anyone's entry; a caregiver only their own.
        allow update, delete: if request.auth != null && request.auth.uid in pm()
          && ( pm()[request.auth.uid] == 'owner' || resource.data.authorId == request.auth.uid );
      }

      match /photos/{photoId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid in pm();
      }
    }
  }
}
