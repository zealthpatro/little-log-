rules_version = '2';

// Little Log security rules.
// - Data lives under /households/{hid}; only that household's members can read/write it.
// - Outsiders (non-members, non-invitees) are fully blocked.
// - Owners can manage membership; caregivers can add entries and edit/delete their own.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's private pointer to their household.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Beta feedback: any signed-in user can submit; only the project owner reads it (console).
    match /feedback/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Pro waitlist: a user manages their own signup; only the project owner reads (console).
    match /waitlist/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Newsletter opt-in list: written ONLY by the edge Worker via the service account (which
    // bypasses these rules). Emails are private — no browser client may read or write it.
    match /newsletter/{id} {
      allow read, write: if false;
    }


    /* The sign-in canary's heartbeat. Server-only: the Worker writes it with admin credentials, which
       bypass this file, and no client has any business reading when sign-in was last proven working.
       Deny-by-default already covers an unmatched path; it is written out because this file states its
       denials rather than relying on them (see /newsletter above). */
    match /ops/{doc} {
      allow read, write: if false;
    }
    /* The sign-in address counts only once it is PROVEN. The token's email claim is whatever the
       account says, and an account made with a password, or by any provider that never checks the
       inbox, can say any address it likes. Wherever the address decides who gets in (an invite, the
       email join) or whose name is shown (an invite's sender, a member's own address), it must come
       with email_verified. Every sign-in Cubby offers sets it: Google, Apple, the emailed link, and
       the emailed code (the Worker makes those accounts verified). A November 2026 count of every
       production account found all of them verified, so nobody real is shut out by this.
       .get() with a default, because a token with no claim at all must deny, not throw. */
    function emailProven() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true;
    }

    // Invites are keyed by the invitee's lowercased email.
    match /invites/{email} {
      /* WHO SENT IT, in a form the sender cannot make up. A newcomer is asked before she joins,
         and that question shows who invited her. The name is whatever the sender typed, so any
         owner of any household could sign an invite "Your midwife". fromEmail is checked here
         against the sender's own sign-in address, so the sheet can show something true beside the
         name. A name may only travel WITH that address: an invite naming its sender but not
         proving the address is refused, and the sheet treats an invite with neither as unsigned. */
      function senderProven() {
        return ( !('fromEmail' in request.resource.data) && !('invitedByName' in request.resource.data) )
          || ( emailProven()
               && request.resource.data.get('fromEmail', '') is string
               && request.resource.data.get('fromEmail', '') != ''
               && request.resource.data.fromEmail == request.auth.token.email.lower() );
      }
      allow read: if emailProven() && request.auth.token.email.lower() == email;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members[request.auth.uid] == 'owner'
        // Role is owner-set here and later enforced at join (SEC-3); constrain it to the two valid
        // values so a bogus role can never be minted. Missing role defaults to caregiver.
        && request.resource.data.get('role', 'caregiver') in ['owner', 'caregiver']
        && senderProven();
      // Only the owning household's owner may update an invite, and it can never be re-pointed at
      // another household (that would let an outsider redirect an invite — or their own invite —
      // into a household they don't own and join it). Invitees never update invites: joining is a
      // write to the household doc itself.
      allow update: if request.auth != null
        && request.resource.data.householdId == resource.data.householdId
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members[request.auth.uid] == 'owner'
        && senderProven();
      // The household's owner may withdraw an invite. An invitee may also delete the invite addressed
      // to their OWN email — needed for account deletion, where a caregiver must be able to clear
      // every trace of themselves without an owner's help (App Store 5.1.1(v): deletion can never be
      // gated on another person). The email is the doc id, so this grants nothing beyond their own.
      allow delete: if request.auth != null && (
           ( emailProven() && request.auth.token.email.lower() == email )
        || get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members[request.auth.uid] == 'owner' );
    }

    /* Invite LINKS, keyed by an unguessable token. Additive: /invites (keyed by email) is untouched
       and still works exactly as before.
       The trade, stated plainly because it is real. /invites can only be read by the person whose
       email it names, which is why "a link on its own is not enough" was true. A token link gives
       that up: whoever holds the link can join. It exists because the sender otherwise has to type
       the other adult's exact sign-in address from memory, and Apple's Hide My Email makes a
       mismatch the DEFAULT for anyone invited at their real address — so the strict version was
       failing shut on the journey this whole product depends on.
       Three things carry the weight instead: the token is unguessable, it expires, and it is
       single-use — claimed here, in the rules, so two people racing the same link cannot both get
       in. The document deliberately holds no baby data: a household id and a role, nothing a
       stranger learns anything from. */
    /* Push caps and campaigns. Both are DENIED to every client, in every mode, on purpose.

       A cap kept in users/{uid} would not be a cap: that document is blanket self-write (see the
       users rule above), so the very person being limited to two marketing messages a month could
       reset the counter. Moving the counter somewhere no client can reach is the whole mechanism.
       The Worker reaches both with a service account, which bypasses rules entirely.

       pushLedger/{uid} holds {caps:{ym,marketing,feature}, sends:{campaignId:{at}}}. `sends` is what
       makes a fan-out idempotent, so a campaign resumed after a timeout cannot deliver twice.
       campaigns/{id} is authored by an operator, never by the app. Nothing in the client reads
       either one, so denying read costs no feature and keeps the send history out of reach. */
    /* One-time sign-in codes. Server-only, like pushLedger below: the Worker reaches these with the
       service account, which bypasses rules entirely, so slamming the door on every client costs
       nothing and removes the whole surface. A client that could READ this collection could read the
       MAC of a live code and grind it offline at its leisure; one that could WRITE it could plant a
       code it knows for somebody else's address and sign in as them. Neither is reachable.
       Never relax this. There is no client use for it, by construction. */
    /* Page counts. Server-only for the same reason as everything else here: the Worker writes them
       with the service account, which bypasses rules, so no client needs an inch of access. Denying
       read also means the counts cannot be mined by a signed-in stranger to learn which households
       or guest pages exist. The documents hold no query strings, no ids and no timestamps finer than
       a day, by construction in recordPageView — but deny it anyway; cheap, and it stays true if the
       shape ever changes. */
    match /pageStats/{id}    { allow read, write: if false; }
    match /signinCodes/{id}  { allow read, write: if false; }
    match /pushLedger/{uid} { allow read, write: if false; }
    match /campaigns/{id}   { allow read, write: if false; }

    /* Remote config: the words, switches and home ordering the app reads instead of a deploy
       (app/index.html, "Remote config"). Every signed-in client may GET it; nobody may list it, and
       no client may write it, ever. Only an operator with the admin key writes it, and the admin SDK
       bypasses these rules. It holds nothing private: the same document goes to every family. The
       client validates every value against a fixed schema and falls back to the compiled defaults, so
       even a bad write by the operator can only reorder, hide or reword what the code already allows. */
    match /config/{doc} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if false;
    }

    match /inviteLinks/{token} {
      /* GET, never LIST. This is the whole security model and it is one word wide.
         The control here is that the document id is a secret, so a reader must already hold the
         token. `allow read` would have granted list as well — and a list needs no token at all, so
         any signed-in stranger could have enumerated every live invite in the database and walked
         into every household. Splitting get from list is what makes "you must know the token"
         actually true.
         The owner's own pending-links list is served from a mirror on her household document, the
         same way pending email invites already are, precisely so that nobody ever needs to query
         this collection. Every member reads that document, so the mirror is keyed by a row id that
         opens nothing; the token itself sits in households/{hid}/ownerLinks/{rowId}, which only an
         owner can read (see there). Rows written before that change were keyed by the token, and the
         owner's own device moves them the first time it opens Cubby under these rules. */
      allow get: if request.auth != null;
      allow list: if false;

      // Only the household's own owner mints one, and only ever pointing at their own household, and
      // only ever as a CAREGIVER link: the app has never minted any other kind (copyAppLink), and an
      // owner-role link handed whoever held its token the power to remove the owner.
      // members.get(uid, '') rather than members[uid] throughout this block: a bare map read of an
      // absent key THROWS, and while a throw does deny, a rule that is correct only because of its
      // error behaviour is not a rule anyone should have to reason about later. Say it outright.
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members.get(request.auth.uid, '') == 'owner'
        && request.resource.data.get('role', 'caregiver') == 'caregiver'
        // .get() rather than a bare field read: referencing an absent field THROWS in rules, and a
        // throw on create would reject the owner's own legitimate link.
        && request.resource.data.get('usedBy', null) == null
        // Same reason: a bare read of an absent expiresAt throws. It would still deny, but say it.
        && request.resource.data.get('expiresAt', null) is timestamp
        // The sender's address, when given, must be their own (see senderProven on /invites). A link
        // without it is still accepted, because older builds never wrote it; the sheet then shows
        // no sender name for it.
        && ( !('fromEmail' in request.resource.data)
             || ( emailProven() && request.resource.data.fromEmail == request.auth.token.email.lower() ) )
        // The row id of the owner's pending-links list that this link clears when it is used (see
        // households, JOINING BY LINK). A string or nothing: links minted before it existed have none.
        && request.resource.data.get('rowId', '') is string;

      // Exactly two updates are legal.
      // 1. The owner edits it, which can never re-point the link at a different household, and can
      //    never change who it says sent it or what role it grants. Revoking is a delete, and the
      //    only owner update the app makes is giving an older link its rowId, so this costs nothing;
      //    it stops an owner writing "Your midwife" over her own address after the rules checked it.
      // 2. The invitee CLAIMS it: sets usedBy to their own uid and consumed: true, once, before it
      //    expires, changing nothing else, AND in the same batch that adds them to the household
      //    (getAfter). The household rule checks the same thing from its side. A claim on its own
      //    is refused, so a link can never be spent by someone who did not get in. That used to
      //    happen to an older cached build after the rules changed: it claimed first and joined
      //    second, the join was refused, and the owner's link was gone for good with nobody in.
      //    The claimer must also be NEW to the family (get, before the batch). getAfter alone was
      //    already true for someone in it, so a caregiver could burn any of the owner's links with a
      //    lone claim, and the person it was meant for was shut out.
      allow update: if request.auth != null
        && request.resource.data.householdId == resource.data.householdId
        && (
          ( get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.get(request.auth.uid, '') == 'owner'
            && request.resource.data.get('fromEmail', null) == resource.data.get('fromEmail', null)
            && request.resource.data.get('invitedByName', null) == resource.data.get('invitedByName', null)
            && request.resource.data.get('role', 'caregiver') == resource.data.get('role', 'caregiver')
            // The one owner edit the app makes: giving a link minted before row ids its row id.
            && request.resource.data.get('rowId', '') is string )
          || (
               resource.data.get('usedBy', null) == null
            && request.resource.data.usedBy == request.auth.uid
            && request.resource.data.get('consumed', false) == true
            && request.time < resource.data.expiresAt
            && request.resource.data.get('role', 'caregiver') == resource.data.get('role', 'caregiver')
            && request.resource.data.expiresAt == resource.data.expiresAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'consumed'])
            && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.get('members', {}).get(request.auth.uid, '') == ''
            && getAfter(/databases/$(database)/documents/households/$(resource.data.householdId)).data.get('members', {}).get(request.auth.uid, '') == resource.data.get('role', 'caregiver')
          )
        );

      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.get(request.auth.uid, '') == 'owner';
    }

    match /households/{hid} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      function isOwner() {
        return request.auth != null && resource.data.members[request.auth.uid] == 'owner';
      }
      function invitedHere() {
        return emailProven()
          && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
          && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.householdId == hid;
      }
      // Pro entitlement is set ONLY by the billing Worker (Admin credentials bypass rules).
      // No client, owner included, may grant or change it.
      function proUnchanged() {
        return request.resource.data.get('pro', null) == resource.data.get('pro', null);
      }
      // The circle-shared app blob must never carry maternal-private data: the pregnancy journey and
      // maternal health live in owner-owned subcollections (/pregnancy, /mhealth), shared only by the
      // mother's explicit consent. Checked ONLY when the blob is actually written, so a household whose
      // stored blob still holds a legacy pregnancy key is never blocked from other edits.
      // NOTE: keep this key list in sync with appBlobFromState() in app/store-firebase.js.
      function appBlobClean() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['app'])
          || !request.resource.data.app.keys().hasAny(['pregnancy', 'mhealth', 'maternalHealth']);
      }
      // A caregiver may edit their OWN memberInfo entry (name, relationship, bear, setup) but never
      // anyone else's. Checked only when memberInfo is actually written, so a normal app-only save
      // (which leaves memberInfo untouched) always passes.
      function onlyOwnMemberInfo() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberInfo'])
          || request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid]);
      }
      // The top-level keys this write touches. Every non-owner branch below is an ALLOW-LIST of
      // these, so a key nobody legitimately writes (deleteAfter, pendingLinks, formerMemberInfo...)
      // can never ride along on a caregiver save or a join.
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      /* Deletion is the purge cron's trigger, and the cron erases the whole family with nothing to
         restore from. So it may be scheduled only the way the app does it (deleteAccount, last one
         out): by an owner, whose write leaves nobody in members, naming themselves, and at least 7
         days ahead. The client writes 30 days from the PHONE's clock. The floor was 29 days, which
         refused a last-one-out deletion outright on a phone more than a day slow, after her private
         records were already gone (App Store 5.1.1(v) needs deletion to finish). A week's floor still
         stops "purge on the next tick" and tolerates a clock up to 23 days slow.
         isOwner() reads the state BEFORE the write, so the owner still counts while leaving.
         Removing both fields stays open to an owner: it only ever cancels a deletion. */
      function deletionScheduledProperly() {
        return !changedKeys().hasAny(['deleteAfter', 'deletionRequestedBy'])
          || ( !('deleteAfter' in request.resource.data) && !('deletionRequestedBy' in request.resource.data) )
          || ( request.resource.data.get('members', {}).size() == 0
               && request.resource.data.get('deletionRequestedBy', null) == request.auth.uid
               && request.resource.data.get('deleteAfter', null) is number
               && request.resource.data.deleteAfter >= request.time.toMillis() + 7 * 24 * 60 * 60 * 1000 );
      }
      /* A member who stays in members keeps their circle entry, and its role label cannot drift
         from what they joined as. Without this a caregiver could delete their own memberInfo entry
         and vanish from the circle screen (and its Remove button) while keeping full access, or
         relabel themselves "owner" on everyone's screen. Absent-before stays allowed so a legacy
         member with no entry can still save a name or a bear. */
      function ownMemberInfoKept() {
        let before = resource.data.get('memberInfo', {});
        let after = request.resource.data.get('memberInfo', {});
        return ( !(request.auth.uid in before) || (request.auth.uid in after) )
          && before.get(request.auth.uid, {}).get('role', null) == after.get(request.auth.uid, {}).get('role', null);
      }
      // A joiner must arrive WITH a circle entry carrying the role they joined as, so nobody joins
      // invisibly and nobody shows as owner who is not one.
      function joinsVisibly() {
        return request.auth.uid in request.resource.data.get('memberInfo', {})
          && request.resource.data.memberInfo[request.auth.uid].get('role', null) == request.resource.data.members[request.auth.uid];
      }
      /* The join branches are doors for people NOT in the family yet. Nobody legitimately rejoins a
         household they are in (the client skips your own household for links and invites alike), so
         a member coming through one is borrowing a newcomer's door: to spend the owner's link and
         delete its pending row, to replace their own circle entry, or to come out of it as owner. */
      function notYetMember() {
        return !(request.auth.uid in resource.data.get('members', {}));
      }
      // A joiner may clear THEIR OWN row from one of the owner's pending lists, and nothing else in it.
      function onlyClearsOwnPending(field, key) {
        return !changedKeys().hasAny([field])
          || ( request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([key])
               && !(key in request.resource.data.get(field, {})) );
      }
      /* TWO DELETIONS AT ONCE. Each phone writes what it last SAW. When the owner (handing over to an
         heir) and the heir (leaving) deleted their accounts at the same moment, the second write
         landed on a family the first had already changed: either the departed heir was written back
         in as owner, or nobody was left and no deletion was scheduled, so the purge never came.
         Nobody else adds anyone to a family: people come in only through the join branches, by
         their own hand. So an owner's write may not add a member, and ANY write that leaves nobody in
         members must be the last one out scheduling the deletion, at least 7 days ahead of the
         server's clock (the app writes 30 from the server's clock). A refused write is the phone's
         cue to look again: the app's deleteAccount reads the family in a transaction. */
      function addsNoMember() {
        return request.resource.data.get('members', {}).diff(resource.data.get('members', {})).addedKeys().size() == 0;
      }
      function emptiesOnlyAsLastOut() {
        return request.resource.data.get('members', {}).size() > 0
          || ( request.resource.data.get('deletionRequestedBy', null) == request.auth.uid
               && request.resource.data.get('deleteAfter', null) is number
               && request.resource.data.deleteAfter >= request.time.toMillis() + 7 * 24 * 60 * 60 * 1000 );
      }

      // Account deletion: a member removes THEMSELVES. Without this a caregiver could not delete
      // their own account, because the isMember() branch below freezes the members map — and
      // App Store 5.1.1(v) forbids gating deletion on an owner's cooperation.
      //
      // An OWNER leaving does not need this branch: isOwner() already permits the fuller update
      // (promoting a successor, or flagging a sole-member household with deleteAfter), and isOwner()
      // reads resource.data, the state BEFORE the write, so they are still owner at check time.
      //
      // Scoped hard so it can never become a privilege-escalation path: exactly three keys may move,
      // the writer must be GONE from members afterwards, and each of those maps may differ only at
      // the writer's own uid. So no promoting, no removing anyone else, no touching ownerId, pro or
      // the app blob. The deletion flag moves only when she is the last one out (see
      // emptiesOnlyAsLastOut), and then it must be set, so a family is never left empty and unflagged.
      function departingSelf() {
        return isMember()
          && !(request.auth.uid in request.resource.data.members)
          // The last one out also schedules the deletion, whatever her role: a family can be left
          // with only a caregiver in it, and she must be able to go too (emptiesOnlyAsLastOut).
          && ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'formerMemberInfo'])
               || ( request.resource.data.members.size() == 0
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'formerMemberInfo', 'deleteAfter', 'deletionRequestedBy']) ) )
          && emptiesOnlyAsLastOut()
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('formerMemberInfo', {}).diff(resource.data.get('formerMemberInfo', {})).affectedKeys().hasOnly([request.auth.uid])
          // The tombstone is required, not just allowed. Every client since July 2026 writes it, and
          // tools/invite_cleanup.js reads it to tell a past member from someone genuinely invited.
          && request.auth.uid in request.resource.data.get('formerMemberInfo', {});
      }

      // Members only. An invitee does NOT read the full household doc pre-join (it carries the app
      // blob + every member's name/email); the join flow reads the narrow invite doc instead, then
      // writes itself into members via the invitedHere() branch of `update` below.
      allow read:   if isMember();
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.get('pro', null) == null
        // Never born flagged for deletion: only the last one out sets the flag (deletionScheduledProperly).
        // Flagged creates would otherwise fill the purge cron's 50-a-tick page and starve real deletions.
        && !('deleteAfter' in request.resource.data)
        && !('deletionRequestedBy' in request.resource.data)
        // Maternal-private data must never be seeded into the circle-shared blob, at CREATE too
        // (appBlobClean() only runs on update, so the invariant is enforced here for a fresh doc).
        && ( !('app' in request.resource.data)
             || !request.resource.data.app.keys().hasAny(['pregnancy', 'mhealth', 'maternalHealth']) );
      // Owner can change anything (except pro, never maternal data into the blob, and the deletion
      // flag only as the last one out). A caregiver may edit shared data and their OWN memberInfo,
      // nothing else. An invitee may join (adds themselves). No one may inject maternal-private data.
      allow update: if proUnchanged() && appBlobClean() && (
           ( isOwner() && deletionScheduledProperly() && addsNoMember() && emptiesOnlyAsLastOut() )
        || departingSelf()
        /* A caregiver: the app blob, updatedAt and their own circle entry, nothing else. Those are
           the only keys a caregiver's client writes (persist, the first-run sheet, the profile, the
           bear). The allow-list is what keeps deleteAfter, the owner's pending lists, tombstones,
           members and ownerId out of reach. */
        || ( isMember()
             && changedKeys().hasOnly(['app', 'updatedAt', 'memberInfo'])
             && onlyOwnMemberInfo()
             && ownMemberInfoKept() )
        /* JOINING BY EMAIL. The invite must be deleted in the same batch (existsAfter), so it is
           spent the moment it is used: an invite that outlived the join was a standing way back in
           for anyone later removed. get() reads the invite as it was before the batch, which is
           what still proves it was addressed to this household with this role. */
        || ( invitedHere()
             && notYetMember()
             && !('deleteAfter' in resource.data)
             && changedKeys().hasOnly(['members', 'memberInfo', 'pendingInvites'])
             && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
             // The joined role must equal the role the OWNER set on the invite (owner-controlled:
             // invites can only be created by an owner). Prevents an invitee self-promoting to
             // 'owner' — hasOnly() above restricts WHICH member key changes, never its value.
             && request.resource.data.members[request.auth.uid] == get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.get('role', 'caregiver')
             && !existsAfter(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
             && onlyOwnMemberInfo()
             && joinsVisibly()
             && onlyClearsOwnPending('pendingInvites', request.auth.token.email.lower()) )
        /* JOINING BY LINK. The role comes off the link, which only an owner can mint, so an invitee
           cannot promote themselves. Single use is enforced HERE, not by the claim alone: the link
           must go from not consumed (get, before this batch) to consumed by this uid (getAfter) in
           this very write, so claim and join are one atomic act; the claim rule checks the same
           pairing from the link's side. A removed member's old token is already consumed and can
           never pass again, and a link claimed by an older build (usedBy set, never consumed)
           cannot be consumed now, because the claim rule only lets an UNCLAIMED link be claimed.
           The expiry is checked again here as a second lock. */
        || ( request.auth != null
             && notYetMember()
             && !('deleteAfter' in resource.data)
             && changedKeys().hasOnly(['members', 'memberInfo', 'joinToken', 'pendingLinks'])
             && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
             && exists(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken))
             && get(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken)).data.get('consumed', false) != true
             && getAfter(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken)).data.get('consumed', false) == true
             && getAfter(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken)).data.usedBy == request.auth.uid
             && get(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken)).data.householdId == hid
             && request.time < get(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken)).data.expiresAt
             && request.resource.data.members[request.auth.uid] == get(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken)).data.get('role', 'caregiver')
             && onlyOwnMemberInfo()
             && joinsVisibly()
             /* Her own row, by the row id the OWNER wrote on the link (the claim may not change it).
                A link minted before row ids has none, and its row is still keyed by the token. An
                older build always clears the token key; on a new link that key is not there, so the
                write changes nothing in the list and is let through (the owner's device tidies the
                row away), rather than shutting out a person who holds a good link. */
             && onlyClearsOwnPending('pendingLinks', get(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken)).data.get('rowId', request.resource.data.joinToken)) ) );
      /* No client deletes a family, owner included. Nothing in the app ever has: a family closes by
         the last one out flagging it (deletionScheduledProperly), and the purge cron erases it with
         the service account, which bypasses this file. A deleted id could be CREATED again by anyone
         who knew it (every past member, invitee and link holder does), and the new "owner" could
         then read the events, photos, notes and addresses still sitting underneath it. */
      allow delete: if false;

      // Members of THIS household (resolved fresh each check).
      function pm() { return get(/databases/$(database)/documents/households/$(hid)).data.members; }

      match /events/{eventId} {
        allow read: if request.auth != null && request.auth.uid in pm();
        // New entries are always authored by the writer ("by Mama Bear" can't be forged).
        allow create: if request.auth != null && request.auth.uid in pm()
          && request.resource.data.authorId == request.auth.uid;
        // Owner can edit/remove anyone's entry; a caregiver only their own. authorId is immutable on
        // update (attribution "by Mama Bear" can't be re-forged after create); delete carries no
        // request.resource, so it stays a separate rule.
        allow update: if request.auth != null && request.auth.uid in pm()
          && ( pm()[request.auth.uid] == 'owner' || resource.data.authorId == request.auth.uid )
          && ( !('authorId' in resource.data) || request.resource.data.authorId == resource.data.authorId );
        allow delete: if request.auth != null && request.auth.uid in pm()
          && ( pm()[request.auth.uid] == 'owner' || resource.data.authorId == request.auth.uid );
      }

      match /photos/{photoId} {
        allow read: if request.auth != null && request.auth.uid in pm();
        // Same authorship model as events: anyone in the circle adds photos as themselves;
        // only the owner or the photo's author may replace or delete one.
        allow create: if request.auth != null && request.auth.uid in pm()
          && request.resource.data.authorId == request.auth.uid;
        // authorId immutable on update (same as events); delete stays separate (no request.resource).
        allow update: if request.auth != null && request.auth.uid in pm()
          && ( pm()[request.auth.uid] == 'owner' || resource.data.authorId == request.auth.uid )
          && ( !('authorId' in resource.data) || request.resource.data.authorId == resource.data.authorId );
        allow delete: if request.auth != null && request.auth.uid in pm()
          && ( pm()[request.auth.uid] == 'owner' || resource.data.authorId == request.auth.uid );
      }

      // Home day-surface notes. NOT in the circle-shared app blob: each note is its own doc so
      // privacy is enforced by rules, not client hiding. A note is readable only by the author,
      // by the single member it is addressed to, or by everyone when its audience is 'circle'.
      // Audience is fixed at create (no client may flip it later); only the author edits/deletes.
      match /notes/{noteId} {
        allow read: if request.auth != null && request.auth.uid in pm() && (
            resource.data.audience == 'circle'
            || resource.data.audience == request.auth.uid
            || resource.data.createdBy == request.auth.uid
        );
        allow create: if request.auth != null && request.auth.uid in pm()
            && request.resource.data.createdBy == request.auth.uid;
        // Audience and authorship are immutable after create (a private note can never be
        // flipped to circle, nor re-attributed); only the author edits/deletes.
        // This is also why a pin is PER MEMBER and not per circle: clearing somebody else's
        // pinned flag would mean widening this update rule to every member, and a private note
        // addressed to a third person is not even readable to the member doing the clearing.
        // Do not widen it for a pin. Home renders every pin instead (pinnedNotes() in index.html).
        allow update: if request.auth != null && request.auth.uid in pm()
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.audience == resource.data.audience
            && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if request.auth != null && request.auth.uid in pm()
            && resource.data.createdBy == request.auth.uid;
      }

      // Member email addresses (PRIV-2). Emails used to ride inside the circle-shared
      // memberInfo blob, where every member could read every other member's address. They
      // now live here: one doc per member, readable only by that member and the household's
      // owner(s), who genuinely need them (pending-invite matching, invite cleanup when
      // someone is removed). A member writes their OWN sign-in address and it must match
      // their auth token, so nobody can plant a fake address; an owner may also write them
      // (the lazy migration out of memberInfo runs on the owner's device) and delete them
      // (member removal). Self-delete skips the membership check so account deletion can
      // always clear a person's own address, even mid-departure.
      match /memberEmails/{uid} {
        allow read: if request.auth != null && request.auth.uid in pm()
            && ( request.auth.uid == uid || pm()[request.auth.uid] == 'owner' );
        allow create, update: if request.auth != null && request.auth.uid in pm() && (
            ( request.auth.uid == uid
              && emailProven()
              && request.resource.data.email == request.auth.token.email.lower() )
            || pm()[request.auth.uid] == 'owner' );
        allow delete: if request.auth != null && (
            request.auth.uid == uid
            || ( request.auth.uid in pm() && pm()[request.auth.uid] == 'owner' ) );
      }

      /* Invite-link TOKENS, where only an owner can read them. The circle's list of pending links
         (pendingLinks on the household document) is read by every member, and it used to be keyed
         by each live link's secret token, so any caregiver could copy one and hand it to anyone. Now
         that list is keyed by a row id that opens nothing, and the token for each row lives here,
         readable and writable by an owner only: she needs it to copy or share the link again, to
         cancel it, and to cancel every live link when she removes someone. Nobody can list
         inviteLinks, and nobody but an owner can read this, so a caregiver has no way to a token.
         Owner-only in full: an heir who is made owner reads them from then on, a removed or
         departed owner never again. */
      match /ownerLinks/{rowId} {
        allow read, delete: if request.auth != null && pm().get(request.auth.uid, '') == 'owner';
        allow create, update: if request.auth != null && pm().get(request.auth.uid, '') == 'owner'
          && request.resource.data.get('token', null) is string;
      }

      // Maternal private health (Privacy Max, gate G1). The mother OWNS her health data.
      // It is NOT in the circle-shared app blob. Each category is shared, by her explicit
      // consent, only with the guardian uid(s) she lists in sharedWith. Mental health
      // (category 'mood') is owner-only and can NEVER be shared. ownerUid is the subject's uid.
      match /mhealth/{owner}/cat/{category} {
        allow read: if request.auth != null && request.auth.uid in pm() && (
            request.auth.uid == owner
            || ( category != 'mood'
                 && resource.data.sharedWith is list
                 && request.auth.uid in resource.data.sharedWith )
        );
        // Only the owner writes her own health, and only as a member of this household.
        allow create, update: if request.auth != null && request.auth.uid == owner
            && request.auth.uid in pm()
            && request.resource.data.ownerUid == owner
            && ( category != 'mood'
                 || !('sharedWith' in request.resource.data)
                 || request.resource.data.sharedWith.size() == 0 );  // mood is never shareable
        /* HER OWN, WITHOUT MEMBERSHIP: find and delete (D2, Nov 2026). An owner who removes a mother
           used to strand her here: every rule above asks for membership, so she could neither see nor
           erase her own health, while anyone she had shared it with could still read it. The record's
           own uid may list her own categories and delete them, in or out of the family. List, not get
           or write: nothing becomes readable to anyone but her, and nothing can be put back. */
        allow list: if request.auth != null && request.auth.uid == owner;
        allow delete: if request.auth != null && request.auth.uid == owner;
      }

      // Pregnancy JOURNEY (Privacy Max, Item 7). The bare fact of expecting is the most sensitive
      // event a family has, so it is NOT in the circle-shared app blob. The owner OWNS her journey
      // (stage, due date, weeks, appointments, kicks, contractions, birth plan, bag, moments, etc.).
      // It is readable by the owner plus any uid she lists in sharedWith (the one-time stakeholder
      // review at creation, editable later). Only the owner writes it. ownerUid is the subject's uid.
      match /pregnancy/{owner} {
        allow read: if request.auth != null && request.auth.uid in pm() && (
            request.auth.uid == owner
            || ( resource.data.sharedWith is list
                 && request.auth.uid in resource.data.sharedWith )
        );
        // Only the owner creates her own journey, and only as a member of this household.
        allow create: if request.auth != null && request.auth.uid == owner
            && request.auth.uid in pm()
            && request.resource.data.ownerUid == owner;
        /* THE ONE FIELD A PARTNER MAY WRITE: data.precon, the shared preparation checklist.
           It is folic acid, a dentist check, easing off alcohol, and it is already rendered to
           the people she chose to tell — it was simply not tickable by them, so the stage meant
           to be done by two people contained nothing two people could do. The list stays on THIS
           document rather than moving to the circle-shared app blob, because that blob is
           readable by every member (a grandparent, a nanny) and a list that opens with folic acid
           announces that someone is trying to conceive to people she never told. The audience has
           to stay exactly the sharedWith[] she picked, which is this document's audience already.
           Scoped so it can never become a way into the rest of the journey: exactly two top-level
           keys may move, and inside `data` exactly one. sharedWith and ownerUid sit outside
           `data`, so hasOnly(['data','updatedAt']) already forbids a partner re-sharing the
           journey or claiming it. */
        function preconOnly() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt'])
            && request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['precon']);
        }
        allow update: if request.auth != null && request.auth.uid in pm() && (
            ( request.auth.uid == owner && request.resource.data.ownerUid == owner )
            || ( resource.data.sharedWith is list
                 && request.auth.uid in resource.data.sharedWith
                 && preconOnly() )
        );
        /* Her own journey, in or out of the family (D2): she may see whether it is there and delete
           it. A removed mother could do neither, and the partner she had told could still read it. */
        allow get: if request.auth != null && request.auth.uid == owner;
        allow delete: if request.auth != null && request.auth.uid == owner;

        // The journey's photo BYTES (bump photos, scan moments, journey-card photos).
        // Their metadata is owner-gated on the doc above, and the bytes must honor the
        // SAME gate — so they live under it, not in the circle-visible /photos
        // collection (which is for the baby's shared story). Readable by the journey
        // owner, or by a member she lists in sharedWith. After a kept loss the parent
        // doc may be gone (pregClear) while kept keepsake bytes remain: the owner
        // branch needs no parent get, so she can always reach her own; nobody else can.
        // Only the owner writes or deletes — same as the journey itself.
        match /photos/{photoId} {
          allow read: if request.auth != null && request.auth.uid in pm() && (
              request.auth.uid == owner
              || ( exists(/databases/$(database)/documents/households/$(hid)/pregnancy/$(owner))
                   && get(/databases/$(database)/documents/households/$(hid)/pregnancy/$(owner)).data.sharedWith is list
                   && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)/pregnancy/$(owner)).data.sharedWith )
          );
          allow create, update: if request.auth != null && request.auth.uid == owner
              && request.auth.uid in pm();
          // Her own bytes, in or out of the family (D2): listed to find them, then deleted.
          allow list: if request.auth != null && request.auth.uid == owner;
          allow delete: if request.auth != null && request.auth.uid == owner;
        }
      }
    }
  }
}
