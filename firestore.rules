rules_version = '2';

// Little Log security rules.
// - Data lives under /households/{hid}; only that household's members can read/write it.
// - Outsiders (non-members, non-invitees) are fully blocked.
// - Owners can manage membership; caregivers can add entries and edit/delete their own.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's private pointer to their household.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Beta feedback: any signed-in user can submit; only the project owner reads it (console).
    match /feedback/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Pro waitlist: a user manages their own signup; only the project owner reads (console).
    match /waitlist/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Newsletter opt-in list: written ONLY by the edge Worker via the service account (which
    // bypasses these rules). Emails are private — no browser client may read or write it.
    match /newsletter/{id} {
      allow read, write: if false;
    }


    /* The sign-in canary's heartbeat. Server-only: the Worker writes it with admin credentials, which
       bypass this file, and no client has any business reading when sign-in was last proven working.
       Deny-by-default already covers an unmatched path; it is written out because this file states its
       denials rather than relying on them (see /newsletter above). */
    match /ops/{doc} {
      allow read, write: if false;
    }
    // Invites are keyed by the invitee's lowercased email.
    match /invites/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members[request.auth.uid] == 'owner'
        // Role is owner-set here and later enforced at join (SEC-3); constrain it to the two valid
        // values so a bogus role can never be minted. Missing role defaults to caregiver.
        && request.resource.data.get('role', 'caregiver') in ['owner', 'caregiver'];
      // Only the owning household's owner may update an invite, and it can never be re-pointed at
      // another household (that would let an outsider redirect an invite — or their own invite —
      // into a household they don't own and join it). Invitees never update invites: joining is a
      // write to the household doc itself.
      allow update: if request.auth != null
        && request.resource.data.householdId == resource.data.householdId
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members[request.auth.uid] == 'owner';
      // The household's owner may withdraw an invite. An invitee may also delete the invite addressed
      // to their OWN email — needed for account deletion, where a caregiver must be able to clear
      // every trace of themselves without an owner's help (App Store 5.1.1(v): deletion can never be
      // gated on another person). The email is the doc id, so this grants nothing beyond their own.
      allow delete: if request.auth != null && (
           request.auth.token.email.lower() == email
        || get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members[request.auth.uid] == 'owner' );
    }

    /* Invite LINKS, keyed by an unguessable token. Additive: /invites (keyed by email) is untouched
       and still works exactly as before.
       The trade, stated plainly because it is real. /invites can only be read by the person whose
       email it names, which is why "a link on its own is not enough" was true. A token link gives
       that up: whoever holds the link can join. It exists because the sender otherwise has to type
       the other adult's exact sign-in address from memory, and Apple's Hide My Email makes a
       mismatch the DEFAULT for anyone invited at their real address — so the strict version was
       failing shut on the journey this whole product depends on.
       Three things carry the weight instead: the token is unguessable, it expires, and it is
       single-use — claimed here, in the rules, so two people racing the same link cannot both get
       in. The document deliberately holds no baby data: a household id and a role, nothing a
       stranger learns anything from. */
    /* Push caps and campaigns. Both are DENIED to every client, in every mode, on purpose.

       A cap kept in users/{uid} would not be a cap: that document is blanket self-write (see the
       users rule above), so the very person being limited to two marketing messages a month could
       reset the counter. Moving the counter somewhere no client can reach is the whole mechanism.
       The Worker reaches both with a service account, which bypasses rules entirely.

       pushLedger/{uid} holds {caps:{ym,marketing,feature}, sends:{campaignId:{at}}}. `sends` is what
       makes a fan-out idempotent, so a campaign resumed after a timeout cannot deliver twice.
       campaigns/{id} is authored by an operator, never by the app. Nothing in the client reads
       either one, so denying read costs no feature and keeps the send history out of reach. */
    /* One-time sign-in codes. Server-only, like pushLedger below: the Worker reaches these with the
       service account, which bypasses rules entirely, so slamming the door on every client costs
       nothing and removes the whole surface. A client that could READ this collection could read the
       MAC of a live code and grind it offline at its leisure; one that could WRITE it could plant a
       code it knows for somebody else's address and sign in as them. Neither is reachable.
       Never relax this. There is no client use for it, by construction. */
    /* Page counts. Server-only for the same reason as everything else here: the Worker writes them
       with the service account, which bypasses rules, so no client needs an inch of access. Denying
       read also means the counts cannot be mined by a signed-in stranger to learn which households
       or guest pages exist. The documents hold no query strings, no ids and no timestamps finer than
       a day, by construction in recordPageView — but deny it anyway; cheap, and it stays true if the
       shape ever changes. */
    match /pageStats/{id}    { allow read, write: if false; }
    match /signinCodes/{id}  { allow read, write: if false; }
    match /pushLedger/{uid} { allow read, write: if false; }
    match /campaigns/{id}   { allow read, write: if false; }

    match /inviteLinks/{token} {
      /* GET, never LIST. This is the whole security model and it is one word wide.
         The control here is that the document id is a secret, so a reader must already hold the
         token. `allow read` would have granted list as well — and a list needs no token at all, so
         any signed-in stranger could have enumerated every live invite in the database and walked
         into every household. Splitting get from list is what makes "you must know the token"
         actually true.
         The owner's own pending-links list is served from a mirror on her household document, the
         same way pending email invites already are, precisely so that nobody ever needs to query
         this collection. */
      allow get: if request.auth != null;
      allow list: if false;

      // Only the household's own owner mints one, and only ever pointing at their own household.
      // members.get(uid, '') rather than members[uid] throughout this block: a bare map read of an
      // absent key THROWS, and while a throw does deny, a rule that is correct only because of its
      // error behaviour is not a rule anyone should have to reason about later. Say it outright.
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members.get(request.auth.uid, '') == 'owner'
        && request.resource.data.get('role', 'caregiver') in ['owner', 'caregiver']
        // .get() rather than a bare field read: referencing an absent field THROWS in rules, and a
        // throw on create would reject the owner's own legitimate link.
        && request.resource.data.get('usedBy', null) == null
        // Same reason: a bare read of an absent expiresAt throws. It would still deny, but say it.
        && request.resource.data.get('expiresAt', null) is timestamp;

      // Exactly two updates are legal.
      // 1. The owner revokes, which can never re-point the link at a different household.
      // 2. The invitee CLAIMS it: sets usedBy to their own uid, once, before it expires, changing
      //    nothing else. An unclaimed link is the only kind that can be claimed, so a forwarded
      //    link is dead the moment the first person walks through it.
      allow update: if request.auth != null
        && request.resource.data.householdId == resource.data.householdId
        && (
          get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.get(request.auth.uid, '') == 'owner'
          || (
               resource.data.get('usedBy', null) == null
            && request.resource.data.usedBy == request.auth.uid
            && request.time < resource.data.expiresAt
            && request.resource.data.role == resource.data.role
            && request.resource.data.expiresAt == resource.data.expiresAt
          )
        );

      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members.get(request.auth.uid, '') == 'owner';
    }

    match /households/{hid} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      function isOwner() {
        return request.auth != null && resource.data.members[request.auth.uid] == 'owner';
      }
      function invitedHere() {
        return request.auth != null
          && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
          && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.householdId == hid;
      }
      // Pro entitlement is set ONLY by the billing Worker (Admin credentials bypass rules).
      // No client, owner included, may grant or change it.
      function proUnchanged() {
        return request.resource.data.get('pro', null) == resource.data.get('pro', null);
      }
      // The circle-shared app blob must never carry maternal-private data: the pregnancy journey and
      // maternal health live in owner-owned subcollections (/pregnancy, /mhealth), shared only by the
      // mother's explicit consent. Checked ONLY when the blob is actually written, so a household whose
      // stored blob still holds a legacy pregnancy key is never blocked from other edits.
      // NOTE: keep this key list in sync with appBlobFromState() in app/store-firebase.js.
      function appBlobClean() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['app'])
          || !request.resource.data.app.keys().hasAny(['pregnancy', 'mhealth', 'maternalHealth']);
      }
      // A caregiver may edit their OWN memberInfo entry (name, relationship, bear, setup) but never
      // anyone else's. Checked only when memberInfo is actually written, so a normal app-only save
      // (which leaves memberInfo untouched) always passes.
      function onlyOwnMemberInfo() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberInfo'])
          || request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid]);
      }
      // Account deletion: a member removes THEMSELVES. Without this a caregiver could not delete
      // their own account, because the isMember() branch below freezes the members map — and
      // App Store 5.1.1(v) forbids gating deletion on an owner's cooperation.
      //
      // An OWNER leaving does not need this branch: isOwner() already permits the fuller update
      // (promoting a successor, or flagging a sole-member household with deleteAfter), and isOwner()
      // reads resource.data, the state BEFORE the write, so they are still owner at check time.
      //
      // Scoped hard so it can never become a privilege-escalation path: exactly three keys may move,
      // the writer must be GONE from members afterwards, and each of those maps may differ only at
      // the writer's own uid. So no promoting, no removing anyone else, no touching ownerId,
      // deleteAfter, pro or the app blob.
      function departingSelf() {
        return isMember()
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'formerMemberInfo'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('formerMemberInfo', {}).diff(resource.data.get('formerMemberInfo', {})).affectedKeys().hasOnly([request.auth.uid]);
      }

      // Members only. An invitee does NOT read the full household doc pre-join (it carries the app
      // blob + every member's name/email); the join flow reads the narrow invite doc instead, then
      // writes itself into members via the invitedHere() branch of `update` below.
      allow read:   if isMember();
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.get('pro', null) == null
        // Maternal-private data must never be seeded into the circle-shared blob, at CREATE too
        // (appBlobClean() only runs on update, so the invariant is enforced here for a fresh doc).
        && ( !('app' in request.resource.data)
             || !request.resource.data.app.keys().hasAny(['pregnancy', 'mhealth', 'maternalHealth']) );
      // Owner can change anything (except pro, and never maternal data into the blob). A caregiver may
      // edit shared data but NOT membership/owner (no privilege escalation) and only their OWN
      // memberInfo. An invitee may join (adds themselves). No one may inject maternal-private data.
      allow update: if proUnchanged() && appBlobClean() && (
           isOwner()
        || departingSelf()
        || ( isMember()
             && request.resource.data.ownerId == resource.data.ownerId
             && request.resource.data.members == resource.data.members
             && onlyOwnMemberInfo() )
        || ( invitedHere()
             && request.resource.data.ownerId == resource.data.ownerId
             && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
             // The joined role must equal the role the OWNER set on the invite (owner-controlled:
             // invites can only be created by an owner). Prevents an invitee self-promoting to
             // 'owner' — hasOnly() above restricts WHICH member key changes, never its value.
             && request.resource.data.members[request.auth.uid] == get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.get('role', 'caregiver')
             && onlyOwnMemberInfo() )
        /* JOINING BY LINK. There was no branch for this at all, so every tokenised invite was
           denied here and invite links failed 100% of the time. The email path above is keyed on
           /invites/{email}; a link joiner has no such document, only a token.
           The gate is the CLAIM the client has already made: claimInviteLink writes usedBy on
           /inviteLinks/{token} first, and that write is single-use and rules-enforced, so reaching
           this branch means this uid won the race for a live token pointing at THIS household. The
           role comes off the link, which only an owner can mint, so an invitee still cannot promote
           themselves. Same shape as the email branch otherwise: ownerId frozen, exactly one member
           key added, and it must be their own. */
        || ( request.auth != null
             && request.resource.data.ownerId == resource.data.ownerId
             && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
             && exists(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken))
             && get(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken)).data.usedBy == request.auth.uid
             && get(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken)).data.householdId == hid
             && request.resource.data.members[request.auth.uid] == get(/databases/$(database)/documents/inviteLinks/$(request.resource.data.joinToken)).data.get('role', 'caregiver')
             && onlyOwnMemberInfo() ) );
      allow delete: if request.auth != null && resource.data.members[request.auth.uid] == 'owner';

      // Members of THIS household (resolved fresh each check).
      function pm() { return get(/databases/$(database)/documents/households/$(hid)).data.members; }

      match /events/{eventId} {
        allow read: if request.auth != null && request.auth.uid in pm();
        // New entries are always authored by the writer ("by Mama Bear" can't be forged).
        allow create: if request.auth != null && request.auth.uid in pm()
          && request.resource.data.authorId == request.auth.uid;
        // Owner can edit/remove anyone's entry; a caregiver only their own. authorId is immutable on
        // update (attribution "by Mama Bear" can't be re-forged after create); delete carries no
        // request.resource, so it stays a separate rule.
        allow update: if request.auth != null && request.auth.uid in pm()
          && ( pm()[request.auth.uid] == 'owner' || resource.data.authorId == request.auth.uid )
          && ( !('authorId' in resource.data) || request.resource.data.authorId == resource.data.authorId );
        allow delete: if request.auth != null && request.auth.uid in pm()
          && ( pm()[request.auth.uid] == 'owner' || resource.data.authorId == request.auth.uid );
      }

      match /photos/{photoId} {
        allow read: if request.auth != null && request.auth.uid in pm();
        // Same authorship model as events: anyone in the circle adds photos as themselves;
        // only the owner or the photo's author may replace or delete one.
        allow create: if request.auth != null && request.auth.uid in pm()
          && request.resource.data.authorId == request.auth.uid;
        // authorId immutable on update (same as events); delete stays separate (no request.resource).
        allow update: if request.auth != null && request.auth.uid in pm()
          && ( pm()[request.auth.uid] == 'owner' || resource.data.authorId == request.auth.uid )
          && ( !('authorId' in resource.data) || request.resource.data.authorId == resource.data.authorId );
        allow delete: if request.auth != null && request.auth.uid in pm()
          && ( pm()[request.auth.uid] == 'owner' || resource.data.authorId == request.auth.uid );
      }

      // Home day-surface notes. NOT in the circle-shared app blob: each note is its own doc so
      // privacy is enforced by rules, not client hiding. A note is readable only by the author,
      // by the single member it is addressed to, or by everyone when its audience is 'circle'.
      // Audience is fixed at create (no client may flip it later); only the author edits/deletes.
      match /notes/{noteId} {
        allow read: if request.auth != null && request.auth.uid in pm() && (
            resource.data.audience == 'circle'
            || resource.data.audience == request.auth.uid
            || resource.data.createdBy == request.auth.uid
        );
        allow create: if request.auth != null && request.auth.uid in pm()
            && request.resource.data.createdBy == request.auth.uid;
        // Audience and authorship are immutable after create (a private note can never be
        // flipped to circle, nor re-attributed); only the author edits/deletes.
        // This is also why a pin is PER MEMBER and not per circle: clearing somebody else's
        // pinned flag would mean widening this update rule to every member, and a private note
        // addressed to a third person is not even readable to the member doing the clearing.
        // Do not widen it for a pin. Home renders every pin instead (pinnedNotes() in index.html).
        allow update: if request.auth != null && request.auth.uid in pm()
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.audience == resource.data.audience
            && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if request.auth != null && request.auth.uid in pm()
            && resource.data.createdBy == request.auth.uid;
      }

      // Member email addresses (PRIV-2). Emails used to ride inside the circle-shared
      // memberInfo blob, where every member could read every other member's address. They
      // now live here: one doc per member, readable only by that member and the household's
      // owner(s), who genuinely need them (pending-invite matching, invite cleanup when
      // someone is removed). A member writes their OWN sign-in address and it must match
      // their auth token, so nobody can plant a fake address; an owner may also write them
      // (the lazy migration out of memberInfo runs on the owner's device) and delete them
      // (member removal). Self-delete skips the membership check so account deletion can
      // always clear a person's own address, even mid-departure.
      match /memberEmails/{uid} {
        allow read: if request.auth != null && request.auth.uid in pm()
            && ( request.auth.uid == uid || pm()[request.auth.uid] == 'owner' );
        allow create, update: if request.auth != null && request.auth.uid in pm() && (
            ( request.auth.uid == uid
              && request.resource.data.email == request.auth.token.email.lower() )
            || pm()[request.auth.uid] == 'owner' );
        allow delete: if request.auth != null && (
            request.auth.uid == uid
            || ( request.auth.uid in pm() && pm()[request.auth.uid] == 'owner' ) );
      }

      // Maternal private health (Privacy Max, gate G1). The mother OWNS her health data.
      // It is NOT in the circle-shared app blob. Each category is shared, by her explicit
      // consent, only with the guardian uid(s) she lists in sharedWith. Mental health
      // (category 'mood') is owner-only and can NEVER be shared. ownerUid is the subject's uid.
      match /mhealth/{owner}/cat/{category} {
        allow read: if request.auth != null && request.auth.uid in pm() && (
            request.auth.uid == owner
            || ( category != 'mood'
                 && resource.data.sharedWith is list
                 && request.auth.uid in resource.data.sharedWith )
        );
        // Only the owner writes her own health, and only as a member of this household.
        allow create, update: if request.auth != null && request.auth.uid == owner
            && request.auth.uid in pm()
            && request.resource.data.ownerUid == owner
            && ( category != 'mood'
                 || !('sharedWith' in request.resource.data)
                 || request.resource.data.sharedWith.size() == 0 );  // mood is never shareable
        allow delete: if request.auth != null && request.auth.uid == owner && request.auth.uid in pm();
      }

      // Pregnancy JOURNEY (Privacy Max, Item 7). The bare fact of expecting is the most sensitive
      // event a family has, so it is NOT in the circle-shared app blob. The owner OWNS her journey
      // (stage, due date, weeks, appointments, kicks, contractions, birth plan, bag, moments, etc.).
      // It is readable by the owner plus any uid she lists in sharedWith (the one-time stakeholder
      // review at creation, editable later). Only the owner writes it. ownerUid is the subject's uid.
      match /pregnancy/{owner} {
        allow read: if request.auth != null && request.auth.uid in pm() && (
            request.auth.uid == owner
            || ( resource.data.sharedWith is list
                 && request.auth.uid in resource.data.sharedWith )
        );
        // Only the owner creates her own journey, and only as a member of this household.
        allow create: if request.auth != null && request.auth.uid == owner
            && request.auth.uid in pm()
            && request.resource.data.ownerUid == owner;
        /* THE ONE FIELD A PARTNER MAY WRITE: data.precon, the shared preparation checklist.
           It is folic acid, a dentist check, easing off alcohol, and it is already rendered to
           the people she chose to tell — it was simply not tickable by them, so the stage meant
           to be done by two people contained nothing two people could do. The list stays on THIS
           document rather than moving to the circle-shared app blob, because that blob is
           readable by every member (a grandparent, a nanny) and a list that opens with folic acid
           announces that someone is trying to conceive to people she never told. The audience has
           to stay exactly the sharedWith[] she picked, which is this document's audience already.
           Scoped so it can never become a way into the rest of the journey: exactly two top-level
           keys may move, and inside `data` exactly one. sharedWith and ownerUid sit outside
           `data`, so hasOnly(['data','updatedAt']) already forbids a partner re-sharing the
           journey or claiming it. */
        function preconOnly() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt'])
            && request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['precon']);
        }
        allow update: if request.auth != null && request.auth.uid in pm() && (
            ( request.auth.uid == owner && request.resource.data.ownerUid == owner )
            || ( resource.data.sharedWith is list
                 && request.auth.uid in resource.data.sharedWith
                 && preconOnly() )
        );
        allow delete: if request.auth != null && request.auth.uid == owner && request.auth.uid in pm();

        // The journey's photo BYTES (bump photos, scan moments, journey-card photos).
        // Their metadata is owner-gated on the doc above, and the bytes must honor the
        // SAME gate — so they live under it, not in the circle-visible /photos
        // collection (which is for the baby's shared story). Readable by the journey
        // owner, or by a member she lists in sharedWith. After a kept loss the parent
        // doc may be gone (pregClear) while kept keepsake bytes remain: the owner
        // branch needs no parent get, so she can always reach her own; nobody else can.
        // Only the owner writes or deletes — same as the journey itself.
        match /photos/{photoId} {
          allow read: if request.auth != null && request.auth.uid in pm() && (
              request.auth.uid == owner
              || ( exists(/databases/$(database)/documents/households/$(hid)/pregnancy/$(owner))
                   && get(/databases/$(database)/documents/households/$(hid)/pregnancy/$(owner)).data.sharedWith is list
                   && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)/pregnancy/$(owner)).data.sharedWith )
          );
          allow create, update: if request.auth != null && request.auth.uid == owner
              && request.auth.uid in pm();
          allow delete: if request.auth != null && request.auth.uid == owner
              && request.auth.uid in pm();
        }
      }
    }
  }
}
