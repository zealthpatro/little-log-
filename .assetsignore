# Gitignored, so only a manual `npx wrangler deploy` of the folder could ship these. It reads this file, not .gitignore.
credentials
art-src
native-build
_local
# Local working folders, gitignored too: wrangler's cache and state (.wrangler/cache/cf.json holds this
# machine's location) and screenshot proof sets. tools/deploy_exclusion_check.js walks for both.
.wrangler
proof

# Internal working material that was being served from the public site. Found 2026-10-22: /design/audit
# (an internal security dashboard that still called a fixed finding "LIVE NOW"), the published rules, the
# SQL schemas and the planning data under /docs were all readable by anyone. Nothing shipped fetches from
# these folders; the only references are comments pointing at postmortems. /mockups/ is NOT here on
# purpose: twelve articles use its SVGs as images.
design
docs
schema
social
storage.rules

# Chaos and fuzz output (gitignored too): open bugs with repro steps, never published.
chaos-failures
reports-dryrun
